{"sections":{"main":{"type":"main-page","custom_css":["h1 {display: none !important;}"],"settings":{"padding_top":28,"padding_bottom":28}},"custom_liquid_pfzbVw":{"type":"custom-liquid","name":"t:sections.custom-liquid.presets.name","settings":{"custom_liquid":"<style>\n  .shopify-section-custom-liquid {\n    display: block !important;\n    padding: 0 !important;\n    margin: 0 !important;\n  }\n\n  .returns-wrapper {\n    width: 100%;\n    max-width: 900px;\n    margin: 80px auto;\n    padding: 0 20px;\n    font-family: 'Assistant', system-ui, -apple-system, sans-serif;\n    direction: rtl;\n  }\n\n  .returns-title {\n    text-align: center;\n    font-size: 3.6rem;\n    font-weight: 900;\n    color: #121212;\n    margin: 0 0 12px;\n    letter-spacing: -0.02em;\n  }\n\n  .returns-sub {\n    text-align: center;\n    font-size: 1.5rem;\n    color: #6b7280;\n    margin: 0 0 50px;\n  }\n\n  \/* --- CARD BASE --- *\/\n  .returns-card {\n    position: relative;\n    isolation: isolate;\n    background:\n      linear-gradient(180deg, rgba(255,255,255,0.9) 0%, rgba(255,255,255,0) 18%),\n      linear-gradient(180deg, #ffffff 0%, #f8f6f1 100%);\n    border: 1px solid #e7e4dc;\n    border-radius: 18px;\n    margin-bottom: 18px;\n    box-shadow:\n      inset 0 1px 0 rgba(255,255,255,0.9),\n      0 1px 2px rgba(15,27,42,0.04),\n      0 6px 16px rgba(15,27,42,0.05);\n    overflow: hidden;\n    transition: transform 0.3s cubic-bezier(0.22, 1, 0.36, 1), box-shadow 0.3s ease, border-color 0.3s ease;\n  }\n\n  .returns-card:hover {\n    transform: translateY(-3px);\n    border-color: rgba(37,211,102,0.4);\n    box-shadow:\n      inset 0 1px 0 rgba(255,255,255,0.9),\n      0 2px 4px rgba(15,27,42,0.05),\n      0 12px 26px rgba(15,27,42,0.09),\n      0 0 0 3px rgba(37,211,102,0.06);\n  }\n\n  .returns-card::before {\n    content: \"\";\n    position: absolute;\n    top: 0;\n    right: 0;\n    width: 4px;\n    height: 100%;\n    background: linear-gradient(180deg, #1bbf5c, #25D366);\n    z-index: 2;\n    pointer-events: none;\n  }\n\n  .returns-card-inner {\n    padding: 28px 34px;\n  }\n\n  .returns-card-head {\n    display: flex;\n    align-items: center;\n    gap: 18px;\n    margin-bottom: 16px;\n  }\n\n  .returns-icon {\n    display: flex;\n    align-items: center;\n    justify-content: center;\n    width: 52px;\n    height: 52px;\n    flex-shrink: 0;\n    border-radius: 14px;\n    background: rgba(37,211,102,0.10);\n    border: 1px solid rgba(37,211,102,0.30);\n    color: #128C4B;\n    transition: background 0.3s ease, transform 0.3s ease;\n  }\n\n  .returns-card:hover .returns-icon {\n    background: rgba(37,211,102,0.16);\n    transform: scale(1.05);\n  }\n\n  .returns-icon svg {\n    width: 26px;\n    height: 26px;\n  }\n\n  .returns-card-title {\n    font-size: 1.7rem;\n    font-weight: 800;\n    color: #121212;\n    margin: 0;\n  }\n\n  .returns-card-body {\n    font-size: 1.4rem;\n    line-height: 1.75;\n    color: #4b5563;\n    font-weight: 500;\n  }\n\n  .returns-card-body strong {\n    color: #121212;\n    font-weight: 800;\n  }\n\n  .returns-card-body a {\n    color: #128C4B;\n    text-decoration: underline;\n    text-underline-offset: 3px;\n    font-weight: bold;\n    transition: color 0.3s ease;\n  }\n\n  .returns-card-body a:hover {\n    color: #0d6b3a;\n  }\n\n  .returns-card-body ul {\n    margin: 12px 0 0;\n    padding-right: 20px;\n  }\n\n  .returns-card-body li {\n    margin-bottom: 10px;\n  }\n\n  \/* --- ACCORDION CARD (נהלים) --- *\/\n  .returns-card details {\n    width: 100%;\n  }\n\n  .returns-card summary {\n    list-style: none;\n    padding: 28px 34px;\n    cursor: pointer;\n    display: flex;\n    align-items: center;\n    justify-content: space-between;\n    gap: 16px;\n  }\n\n  .returns-card summary::-webkit-details-marker {\n    display: none;\n  }\n\n  .returns-card summary:focus {\n    outline: none;\n  }\n\n  .returns-card summary:focus-visible {\n    outline: 2px solid rgba(37,211,102,0.6);\n    outline-offset: -2px;\n    border-radius: 18px;\n  }\n\n  .returns-q-content {\n    display: flex;\n    align-items: center;\n    gap: 18px;\n  }\n\n  .returns-toggle-icon {\n    display: flex;\n    align-items: center;\n    justify-content: center;\n    width: 38px;\n    height: 38px;\n    flex-shrink: 0;\n    border-radius: 50%;\n    background: #ffffff;\n    border: 1px solid #e7e4dc;\n    box-shadow: 0 2px 6px rgba(15,27,42,0.06);\n    transition: background 0.3s ease, border-color 0.3s ease, transform 0.35s cubic-bezier(0.22, 1, 0.36, 1);\n  }\n\n  .returns-toggle-icon svg {\n    width: 18px;\n    height: 18px;\n    stroke: #121212;\n    transition: stroke 0.3s ease;\n  }\n\n  .returns-card:hover .returns-toggle-icon {\n    border-color: rgba(37,211,102,0.5);\n  }\n\n  .returns-card details[open] .returns-toggle-icon {\n    background: #25D366;\n    border-color: #25D366;\n    transform: rotate(180deg);\n  }\n\n  .returns-card details[open] .returns-toggle-icon svg {\n    stroke: #ffffff;\n  }\n\n  .returns-accordion-body {\n    padding: 20px 34px 30px;\n    font-size: 1.4rem;\n    line-height: 1.75;\n    color: #4b5563;\n    font-weight: 500;\n    border-top: 1px dashed rgba(15,27,42,0.10);\n  }\n\n  .returns-accordion-body strong {\n    color: #121212;\n    font-weight: 800;\n  }\n\n  .returns-accordion-body ul {\n    margin: 12px 0 0;\n    padding-right: 20px;\n  }\n\n  .returns-accordion-body li {\n    margin-bottom: 12px;\n  }\n\n  .returns-card details[open] summary ~ * {\n    animation: sweep 0.4s ease-in-out;\n  }\n\n  @keyframes sweep {\n    0%   { opacity: 0; transform: translateY(-10px); }\n    100% { opacity: 1; transform: translateY(0); }\n  }\n\n  \/* address box inside the accordion *\/\n  .returns-address {\n    display: block;\n    background: rgba(37,211,102,0.07);\n    border: 1px dashed rgba(37,211,102,0.45);\n    border-radius: 12px;\n    padding: 14px 18px;\n    margin: 10px 0 4px;\n    font-weight: 700;\n    color: #121212;\n    direction: ltr;\n    text-align: left;\n    line-height: 1.6;\n  }\n\n  .returns-footer {\n    text-align: center;\n    margin-top: 36px;\n    font-size: 1.4rem;\n    color: #6b7280;\n  }\n\n  .returns-footer a {\n    color: #128C4B;\n    font-weight: 800;\n    text-decoration: underline;\n    text-underline-offset: 3px;\n  }\n\n  \/* --- MOBILE --- *\/\n  @media screen and (max-width: 749px) {\n    .returns-wrapper { margin: 50px auto; }\n    .returns-title { font-size: 2.6rem; }\n    .returns-sub { font-size: 1.25rem; margin-bottom: 34px; }\n    .returns-card-inner { padding: 20px 18px; }\n    .returns-card summary { padding: 20px 18px; }\n    .returns-accordion-body { padding: 16px 18px 22px; font-size: 1.22rem; }\n    .returns-card-title { font-size: 1.35rem; }\n    .returns-card-body { font-size: 1.22rem; }\n    .returns-q-content { gap: 12px; }\n    .returns-icon { width: 42px; height: 42px; border-radius: 12px; }\n    .returns-icon svg { width: 21px; height: 21px; }\n    .returns-toggle-icon { width: 32px; height: 32px; }\n    .returns-toggle-icon svg { width: 15px; height: 15px; }\n  }\n\n  @media (prefers-reduced-motion: reduce) {\n    .returns-card,\n    .returns-icon,\n    .returns-toggle-icon {\n      transition: none;\n    }\n    .returns-card details[open] summary ~ * {\n      animation: none;\n    }\n  }\n<\/style>\n\n<div class=\"returns-wrapper\">\n  <h2 class=\"returns-title\">החזרות והחלפות<\/h2>\n  <p class=\"returns-sub\">המדיניות המלאה — שקוף, מסודר, בלי אותיות קטנות<\/p>\n\n  <!-- מוצרים בייצור אישי -->\n  <div class=\"returns-card\">\n    <div class=\"returns-card-inner\">\n      <div class=\"returns-card-head\">\n        <div class=\"returns-icon\">\n          <svg viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\"><path d=\"M20.38 3.46L16 2a4 4 0 01-8 0L3.62 3.46a2 2 0 00-1.34 2.23l.58 3.47a1 1 0 00.99.84H6v10c0 1.1.9 2 2 2h8a2 2 0 002-2V10h2.15a1 1 0 00.99-.84l.58-3.47a2 2 0 00-1.34-2.23z\"><\/path><\/svg>\n        <\/div>\n        <h3 class=\"returns-card-title\">מוצרים בייצור אישי<\/h3>\n      <\/div>\n      <div class=\"returns-card-body\">\n        המוצרים באתר <strong>מיוצרים באופן אישי עבור כל לקוח<\/strong> בהתאם לבחירותיו בהזמנה (דגם, מידה, גרסה, כיתוב). בהתאם לסעיף 14ג(ד) לחוק הגנת הצרכן, <strong>טובין שיוצרו במיוחד עבור הצרכן אינם ניתנים לביטול והחזרה<\/strong>. לכן לא ניתן להחזיר או להחליף מוצר שהגיע תקין ותואם להזמנה.\n      <\/div>\n    <\/div>\n  <\/div>\n\n  <!-- בחירת מידה שגויה -->\n  <div class=\"returns-card\">\n    <div class=\"returns-card-inner\">\n      <div class=\"returns-card-head\">\n        <div class=\"returns-icon\">\n          <svg viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\"><path d=\"M21.73 18l-8-14a2 2 0 0 0-3.46 0l-8 14A2 2 0 0 0 4 21h16a2 2 0 0 0 1.73-3z\"><\/path><line x1=\"12\" y1=\"9\" x2=\"12\" y2=\"13\"><\/line><line x1=\"12\" y1=\"17\" x2=\"12.01\" y2=\"17\"><\/line><\/svg>\n        <\/div>\n        <h3 class=\"returns-card-title\">בחירת מידה שגויה<\/h3>\n      <\/div>\n      <div class=\"returns-card-body\">\n        המוצרים נשלחים <strong>בדיוק לפי המידות שנבחרו בהזמנה<\/strong>, בהתאם ל<a href=\"https:\/\/hashofet.com\/pages\/טבלת-מידות\">טבלת המידות המפורטת<\/a> באתר. בחירת מידה שאינה מתאימה אינה מהווה פגם במוצר ואינה מזכה בהחזרה או החלפה. לכן חשוב מאוד למדוד ולוודא מול הטבלה לפני ההזמנה — ובכל שאלה, שירות הלקוחות שלנו זמין לעזור בבחירת המידה הנכונה.\n        <br><br>\n        עם זאת, אנחנו תמיד נשמח לבוא לקראת — במקרים כאלה ניתן לפנות לשירות הלקוחות ונציע <strong>פתרון מותאם<\/strong>, כגון קוד קופון להנחה משמעותית על הזמנה חדשה במידה הנכונה.\n      <\/div>\n    <\/div>\n  <\/div>\n\n  <!-- נהלי החזרה — אקורדיון -->\n  <div class=\"returns-card\">\n    <details>\n      <summary>\n        <div class=\"returns-q-content\">\n          <div class=\"returns-icon\">\n            <svg viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\"><polyline points=\"1 4 1 10 7 10\"><\/polyline><path d=\"M3.51 15a9 9 0 1 0 2.13-9.36L1 10\"><\/path><\/svg>\n          <\/div>\n          <span class=\"returns-card-title\">נהלי החזרה — בתיאום מראש בלבד<\/span>\n        <\/div>\n        <div class=\"returns-toggle-icon\"><svg viewBox=\"0 0 24 24\" fill=\"none\" stroke-width=\"3\" stroke-linecap=\"round\" stroke-linejoin=\"round\"><polyline points=\"6 9 12 15 18 9\"><\/polyline><\/svg><\/div>\n      <\/summary>\n      <div class=\"returns-accordion-body\">\n        במקרים שבהם אושרה החזרה מול שירות הלקוחות (לפנים משורת הדין), ההחזרה מתבצעת <strong>למרכז הלוגיסטי שלנו בחו\"ל<\/strong> לפי הנהלים הבאים:\n        <ul>\n          <li><strong>כתובת למשלוח:<\/strong>\n            <span class=\"returns-address\">\n              Cainiao Inn, No. 1, Baiyun, Shiqiao Street,<br>\n              Panyu District, Guangzhou, China<br>\n              Name: Li Si | Phone: 4176525\n            <\/span>\n          <\/li>\n          <li>יש לארוז את הפריטים <strong>במצב חדש, עם התוויות המקוריות<\/strong>.<\/li>\n          <li>בטופס הדואר, בשדה תיאור התוכן, חובה לרשום: <strong>\"Returned Goods\"<\/strong> — ללא ציון זה החבילה תיעצר במכס.<\/li>\n          <li>בשדה \"ערך מוצהר\" (Declared Value) יש לרשום <strong>10$<\/strong> — דרישה לצורכי מכס בצד המרכז הלוגיסטי. ערך גבוה יותר יגרור מיסי ייבוא והחבילה תוחזר לשולח.<\/li>\n          <li>המשלוח בדואר רשום עם <strong>מספר מעקב<\/strong>, ויש להעביר לשירות הלקוחות את מספר המעקב + צילום אישור המשלוח.<\/li>\n        <\/ul>\n        <br>\n        <strong>עלות משלוח ההחזרה חלה על הלקוח<\/strong> (למעט במקרי פגם או טעות מצדנו). הטיפול בהחזרה — החלפה או זיכוי, בהתאם לסיכום — יבוצע לאחר קבלת הפריטים ואישורם.\n        <br><br>\n        <strong>החזרה שנשלחה ללא תיאום מראש מול שירות הלקוחות — לא תטופל.<\/strong>\n      <\/div>\n    <\/details>\n  <\/div>\n\n  <!-- פגם או טעות מצדנו -->\n  <div class=\"returns-card\">\n    <div class=\"returns-card-inner\">\n      <div class=\"returns-card-head\">\n        <div class=\"returns-icon\">\n          <svg viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\"><path d=\"M22 11.08V12a10 10 0 1 1-5.93-9.14\"><\/path><polyline points=\"22 4 12 14.01 9 11.01\"><\/polyline><\/svg>\n        <\/div>\n        <h3 class=\"returns-card-title\">פגם או טעות מצדנו — באחריותנו המלאה<\/h3>\n      <\/div>\n      <div class=\"returns-card-body\">\n        קיבלתם מוצר <strong>פגום, שגוי, או שאינו תואם את ההזמנה<\/strong> (דגם\/מידה\/כיתוב שונים ממה שהוזמן)? זה עלינו, מקצה לקצה:\n        <ul>\n          <li>פנו לשירות הלקוחות תוך <strong>14 יום מקבלת המוצר<\/strong>, בצירוף מספר הזמנה ותמונות.<\/li>\n          <li>לאחר אימות הפנייה — תקבלו לבחירתכם <strong>מוצר חלופי תקין על חשבוננו<\/strong> או <strong>זיכוי כספי<\/strong>.<\/li>\n          <li>במקרים אלו לא תישאו בשום עלות נוספת.<\/li>\n        <\/ul>\n      <\/div>\n    <\/div>\n  <\/div>\n\n  <!-- ביטול לפני ייצור -->\n  <div class=\"returns-card\">\n    <div class=\"returns-card-inner\">\n      <div class=\"returns-card-head\">\n        <div class=\"returns-icon\">\n          <svg viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\"><circle cx=\"12\" cy=\"12\" r=\"10\"><\/circle><polyline points=\"12 6 12 12 16 14\"><\/polyline><\/svg>\n        <\/div>\n        <h3 class=\"returns-card-title\">ביטול הזמנה לפני ייצור<\/h3>\n      <\/div>\n      <div class=\"returns-card-body\">\n        ניתן לבטל הזמנה <strong>כל עוד לא נכנסה לתהליך ייצור<\/strong> — בדרך כלל בטווח של שעות בודדות ממועד ההזמנה. לביטול יש לפנות לשירות הלקוחות בהקדם האפשרי בצירוף מספר ההזמנה. הזמנה שנכנסה לייצור או נשלחה — לא ניתנת לביטול, בהתאם למדיניות המוצרים בייצור אישי.\n      <\/div>\n    <\/div>\n  <\/div>\n\n  <!-- איך פונים -->\n  <div class=\"returns-card\">\n    <div class=\"returns-card-inner\">\n      <div class=\"returns-card-head\">\n        <div class=\"returns-icon\">\n          <svg viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\"><path d=\"M21 11.5a8.38 8.38 0 0 1-.9 3.8 8.5 8.5 0 0 1-7.6 4.7 8.38 8.38 0 0 1-3.8-.9L3 21l1.9-5.7a8.38 8.38 0 0 1-.9-3.8 8.5 8.5 0 0 1 4.7-7.6 8.38 8.38 0 0 1 3.8-.9h.5a8.48 8.48 0 0 1 8 8v.5z\"><\/path><\/svg>\n        <\/div>\n        <h3 class=\"returns-card-title\">איך פונים?<\/h3>\n      <\/div>\n      <div class=\"returns-card-body\">\n        כל פנייה בנושא החזרות, פגמים או ביטולים מתבצעת מול <strong>שירות הלקוחות בוואטסאפ<\/strong>, בצירוף מספר הזמנה. אנחנו עונים מהר, בשקיפות, ומלווים כל פנייה עד לפתרון מלא.\n      <\/div>\n    <\/div>\n  <\/div>\n\n  <div class=\"returns-footer\">\n    יש שאלה על הזמנה קיימת? <a href=\"https:\/\/wa.me\/YOUR_NUMBER\">דברו איתנו בוואטסאפ 💬<\/a>\n  <\/div>\n<\/div>","color_scheme":"","padding_top":40,"padding_bottom":52}}},"order":["main","custom_liquid_pfzbVw"]}