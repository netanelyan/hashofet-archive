{"sections":{"main":{"type":"main-page","disabled":true,"custom_css":["h2 {text-align: center;}"],"settings":{"padding_top":28,"padding_bottom":28}},"custom_liquid_EmDJ6E":{"type":"custom-liquid","name":"t:sections.custom-liquid.presets.name","settings":{"custom_liquid":"<style>\n  \/* --- GLOBAL SECTION RESET --- *\/\n  .shopify-section-custom-liquid {\n    display: block !important;\n    padding: 0 !important;\n    margin: 0 !important;\n  }\n\n  \/* --- MAIN WRAPPER --- *\/\n  .super-faq-wrapper {\n    width: 100%;\n    max-width: 900px;\n    margin: 80px auto;\n    padding: 0 20px;\n    font-family: 'Assistant', system-ui, -apple-system, sans-serif;\n    direction: rtl;\n  }\n\n  \/* --- TITLE --- *\/\n  .super-faq-title {\n    text-align: center;\n    font-size: 3.6rem;\n    font-weight: 900;\n    color: #121212;\n    margin: 0 0 12px;\n    letter-spacing: -0.02em;\n  }\n\n  .super-faq-sub {\n    text-align: center;\n    font-size: 1.5rem;\n    color: #6b7280;\n    margin: 0 0 50px;\n  }\n\n  \/* --- FAQ ITEMS (matching site card language) --- *\/\n  .super-faq-item {\n    position: relative;\n    isolation: isolate;\n    background:\n      linear-gradient(180deg, rgba(255,255,255,0.9) 0%, rgba(255,255,255,0) 18%),\n      linear-gradient(180deg, #ffffff 0%, #f8f6f1 100%);\n    border: 1px solid #e7e4dc;\n    border-radius: 18px;\n    margin-bottom: 18px;\n    box-shadow:\n      inset 0 1px 0 rgba(255,255,255,0.9),\n      0 1px 2px rgba(15,27,42,0.04),\n      0 6px 16px rgba(15,27,42,0.05);\n    overflow: hidden;\n    transition:\n      transform 0.3s cubic-bezier(0.22, 1, 0.36, 1),\n      box-shadow 0.3s ease,\n      border-color 0.3s ease;\n  }\n\n  .super-faq-item:hover {\n    transform: translateY(-3px);\n    border-color: rgba(37,211,102,0.4);\n    box-shadow:\n      inset 0 1px 0 rgba(255,255,255,0.9),\n      0 2px 4px rgba(15,27,42,0.05),\n      0 12px 26px rgba(15,27,42,0.09),\n      0 0 0 3px rgba(37,211,102,0.06);\n  }\n\n  \/* green right-edge accent line - grows when open *\/\n  .super-faq-item::before {\n    content: \"\";\n    position: absolute;\n    top: 50%;\n    right: 0;\n    transform: translateY(-50%);\n    width: 4px;\n    height: 0%;\n    border-radius: 4px 0 0 4px;\n    background: linear-gradient(180deg, #1bbf5c, #25D366);\n    transition: height 0.35s cubic-bezier(0.22, 1, 0.36, 1);\n    z-index: 2;\n    pointer-events: none;\n  }\n\n  .super-faq-item:hover::before {\n    height: 40%;\n  }\n\n  .super-faq-item:has(details[open])::before {\n    height: 100%;\n    border-radius: 0;\n  }\n\n  .super-faq-item:has(details[open]) {\n    border-color: rgba(37,211,102,0.45);\n  }\n\n  \/* --- NATIVE ACCORDION --- *\/\n  details {\n    width: 100%;\n  }\n\n  summary {\n    list-style: none;\n    padding: 28px 34px;\n    font-size: 1.7rem;\n    font-weight: 800;\n    color: #121212;\n    cursor: pointer;\n    display: flex;\n    align-items: center;\n    justify-content: space-between;\n    gap: 16px;\n    transition: background 0.25s ease;\n  }\n\n  summary::-webkit-details-marker {\n    display: none;\n  }\n\n  summary:focus {\n    outline: none;\n  }\n\n  summary:focus-visible {\n    outline: 2px solid rgba(37,211,102,0.6);\n    outline-offset: -2px;\n    border-radius: 18px;\n  }\n\n  .faq-q-content {\n    display: flex;\n    align-items: center;\n    gap: 18px;\n  }\n\n  \/* --- ICONS: green tinted chip --- *\/\n  .faq-icon {\n    display: flex;\n    align-items: center;\n    justify-content: center;\n    width: 52px;\n    height: 52px;\n    flex-shrink: 0;\n    border-radius: 14px;\n    background: rgba(37,211,102,0.10);\n    border: 1px solid rgba(37,211,102,0.30);\n    color: #128C4B;\n    transition: background 0.3s ease, transform 0.3s ease;\n  }\n\n  .super-faq-item:hover .faq-icon,\n  details[open] .faq-icon {\n    background: rgba(37,211,102,0.16);\n    transform: scale(1.05);\n  }\n\n  .faq-icon svg {\n    width: 26px;\n    height: 26px;\n  }\n\n  \/* --- Chevron toggle: circled arrow, flips when open --- *\/\n  .faq-toggle-icon {\n    display: flex;\n    align-items: center;\n    justify-content: center;\n    width: 38px;\n    height: 38px;\n    flex-shrink: 0;\n    border-radius: 50%;\n    background: #ffffff;\n    border: 1px solid #e7e4dc;\n    box-shadow: 0 2px 6px rgba(15,27,42,0.06);\n    transition: background 0.3s ease, border-color 0.3s ease, transform 0.35s cubic-bezier(0.22, 1, 0.36, 1);\n  }\n\n  .faq-toggle-icon svg {\n    width: 18px;\n    height: 18px;\n    stroke: #121212;\n    transition: stroke 0.3s ease;\n  }\n\n  .super-faq-item:hover .faq-toggle-icon {\n    border-color: rgba(37,211,102,0.5);\n  }\n\n  details[open] .faq-toggle-icon {\n    background: #25D366;\n    border-color: #25D366;\n    transform: rotate(180deg);\n  }\n\n  details[open] .faq-toggle-icon svg {\n    stroke: #ffffff;\n  }\n\n  \/* --- ANSWER --- *\/\n  .super-faq-answer {\n    padding: 0 34px 30px calc(34px + 8px);\n    margin-right: 70px; \/* aligns answer under the question text, past the icon *\/\n    font-size: 1.4rem;\n    line-height: 1.75;\n    color: #4b5563;\n    font-weight: 500;\n    border-top: 1px dashed rgba(15,27,42,0.10);\n    padding-top: 20px;\n  }\n\n  .super-faq-answer strong {\n    color: #121212;\n    font-weight: 800;\n  }\n\n  .super-faq-answer a {\n    color: #128C4B;\n    text-decoration: underline;\n    text-underline-offset: 3px;\n    font-weight: bold;\n    transition: color 0.3s ease;\n  }\n\n  .super-faq-answer a:hover {\n    color: #0d6b3a;\n  }\n\n  details[open] summary ~ * {\n    animation: sweep 0.4s ease-in-out;\n  }\n\n  @keyframes sweep {\n    0%    { opacity: 0; transform: translateY(-10px); }\n    100%  { opacity: 1; transform: translateY(0); }\n  }\n\n  \/* --- WhatsApp helper line at the bottom --- *\/\n  .super-faq-footer {\n    text-align: center;\n    margin-top: 36px;\n    font-size: 1.4rem;\n    color: #6b7280;\n  }\n\n  .super-faq-footer a {\n    color: #128C4B;\n    font-weight: 800;\n    text-decoration: underline;\n    text-underline-offset: 3px;\n  }\n\n  \/* --- MOBILE --- *\/\n  @media screen and (max-width: 749px) {\n    .super-faq-wrapper {\n      margin: 50px auto;\n    }\n\n    .super-faq-title {\n      font-size: 2.6rem;\n    }\n\n    .super-faq-sub {\n      font-size: 1.25rem;\n      margin-bottom: 34px;\n    }\n\n    summary {\n      padding: 20px 18px;\n      font-size: 1.35rem;\n    }\n\n    .super-faq-answer {\n      padding: 16px 18px 22px 18px;\n      margin-right: 0;\n      font-size: 1.22rem;\n    }\n\n    .faq-q-content {\n      gap: 12px;\n    }\n\n    .faq-icon {\n      width: 42px;\n      height: 42px;\n      border-radius: 12px;\n    }\n\n    .faq-icon svg {\n      width: 21px;\n      height: 21px;\n    }\n\n    .faq-toggle-icon {\n      width: 32px;\n      height: 32px;\n    }\n\n    .faq-toggle-icon svg {\n      width: 15px;\n      height: 15px;\n    }\n  }\n\n  @media (prefers-reduced-motion: reduce) {\n    .super-faq-item,\n    .faq-icon,\n    .faq-toggle-icon,\n    .super-faq-item::before {\n      transition: none;\n    }\n    details[open] summary ~ * {\n      animation: none;\n    }\n  }\n<\/style>\n\n<div class=\"super-faq-wrapper\">\n  <h2 class=\"super-faq-title\">שאלות נפוצות<\/h2>\n  <p class=\"super-faq-sub\">כל מה שחשוב לדעת לפני שמזמינים<\/p>\n\n  <div class=\"super-faq-item\">\n    <details>\n      <summary>\n        <div class=\"faq-q-content\">\n          <div class=\"faq-icon\">\n            <svg viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\"><rect x=\"1\" y=\"4\" width=\"22\" height=\"16\" rx=\"2\" ry=\"2\"><\/rect><line x1=\"1\" y1=\"10\" x2=\"23\" y2=\"10\"><\/line><\/svg>\n          <\/div>\n          <span>איך ניתן לשלם?<\/span>\n        <\/div>\n        <div class=\"faq-toggle-icon\"><svg viewBox=\"0 0 24 24\" fill=\"none\" stroke-width=\"3\" stroke-linecap=\"round\" stroke-linejoin=\"round\"><polyline points=\"6 9 12 15 18 9\"><\/polyline><\/svg><\/div>\n      <\/summary>\n      <div class=\"super-faq-answer\">\n        ניתן לשלם ב-<strong>PayPal<\/strong> או ב<strong>העברה בנקאית<\/strong>.\n        <br><br>\n        <strong>למה העברה בנקאית?<\/strong> ככה אנחנו חוסכים עמלות סליקה, וזה חלק ממה שמאפשר לנו לשמור על המחירים הכי נמוכים. וזה פשוט: אחרי ההזמנה תקבלו את פרטי החשבון בוואטסאפ, מעבירים, שולחים צילום מסך, וההזמנה יוצאת לדרך. על כל תשלום תקבלו קבלה.\n        <br><br>\n        <strong>מזמינים כקבוצה?<\/strong> אחד מעביר את כל הסכום, והחברים מתחשבנים איתו.\n      <\/div>\n    <\/details>\n  <\/div>\n\n  <div class=\"super-faq-item\">\n    <details>\n      <summary>\n        <div class=\"faq-q-content\">\n          <div class=\"faq-icon\">\n            <svg viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\"><path d=\"M21 16V8a2 2 0 0 0-1-1.73l-7-4a2 2 0 0 0-2 0l-7 4A2 2 0 0 0 3 8v8a2 2 0 0 0 1 1.73l7 4a2 2 0 0 0 2 0l7-4A2 2 0 0 0 21 16z\"><\/path><polyline points=\"3.27 6.96 12 12.01 20.73 6.96\"><\/polyline><line x1=\"12\" y1=\"22.08\" x2=\"12\" y2=\"12\"><\/line><\/svg>\n          <\/div>\n          <span>כמה זמן לוקח למשלוח להגיע?<\/span>\n        <\/div>\n        <div class=\"faq-toggle-icon\"><svg viewBox=\"0 0 24 24\" fill=\"none\" stroke-width=\"3\" stroke-linecap=\"round\" stroke-linejoin=\"round\"><polyline points=\"6 9 12 15 18 9\"><\/polyline><\/svg><\/div>\n      <\/summary>\n      <div class=\"super-faq-answer\">\n        המשלוחים נשלחים לנקודת חלוקה סמוכה לכתובת שהוזנה בהזמנה. זמן האספקה <strong>המשוער<\/strong> עומד על <strong>10-14 ימי עסקים<\/strong>, ובתקופות עומס (מונדיאל, חגים, מבצעים) ובמקרים חריגים ייתכן עיכוב של <strong>עד 21 ימי עסקים<\/strong>. הזמנים הם הערכה בלבד ותלויים בגורמי ייצור, לוגיסטיקה ומכס, ואנו עושים כל מאמץ שההזמנה תגיע במהירות האפשרית. <strong>במצבי חירום, מלחמה או אירועים ביטחוניים ייתכן שזמני המשלוח יהיו פחות יציבים מהרגיל.<\/strong>\n      <\/div>\n    <\/details>\n  <\/div>\n\n  <div class=\"super-faq-item\">\n    <details>\n      <summary>\n        <div class=\"faq-q-content\">\n          <div class=\"faq-icon\">\n            <svg viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\"><path d=\"M20.38 3.46L16 2a4 4 0 01-8 0L3.62 3.46a2 2 0 00-1.34 2.23l.58 3.47a1 1 0 00.99.84H6v10c0 1.1.9 2 2 2h8a2 2 0 002-2V10h2.15a1 1 0 00.99-.84l.58-3.47a2 2 0 00-1.34-2.23z\"><\/path><\/svg>\n          <\/div>\n          <span>המוצרים זהים למקור?<\/span>\n        <\/div>\n        <div class=\"faq-toggle-icon\"><svg viewBox=\"0 0 24 24\" fill=\"none\" stroke-width=\"3\" stroke-linecap=\"round\" stroke-linejoin=\"round\"><polyline points=\"6 9 12 15 18 9\"><\/polyline><\/svg><\/div>\n      <\/summary>\n      <div class=\"super-faq-answer\">\n        כן. המוצרים זהים במראה ובפרטים למוצר המקורי, גם סוג הפונט (כולל הכיתוב מאחור), הצבעים, וסוג הבד. ההבדל היחיד בין מוצרינו למוצרים מקוריים הוא <strong>המחיר המשתלם<\/strong> משמעותית שאנו מציעים.\n      <\/div>\n    <\/details>\n  <\/div>\n\n  <div class=\"super-faq-item\">\n    <details>\n      <summary>\n        <div class=\"faq-q-content\">\n          <div class=\"faq-icon\">\n            <svg viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\"><polyline points=\"1 4 1 10 7 10\"><\/polyline><path d=\"M3.51 15a9 9 0 1 0 2.13-9.36L1 10\"><\/path><\/svg>\n          <\/div>\n          <span>מהי מדיניות ההחזרות וההחלפות?<\/span>\n        <\/div>\n        <div class=\"faq-toggle-icon\"><svg viewBox=\"0 0 24 24\" fill=\"none\" stroke-width=\"3\" stroke-linecap=\"round\" stroke-linejoin=\"round\"><polyline points=\"6 9 12 15 18 9\"><\/polyline><\/svg><\/div>\n      <\/summary>\n      <div class=\"super-faq-answer\">\n        חולצות עם <strong>שם, מספר או פאץ'<\/strong> מיוצרות במיוחד עבורכם ולכן לא ניתן להחזירן או להחליפן. במיוחד בשביל זה הכנו <a href=\"https:\/\/hashofet.com\/pages\/טבלת-מידות\">טבלת מידות<\/a> מדויקת (המידות לפי גובה ולא לפי גיל) כדי שתדעו בדיוק איזו מידה להזמין. במקרה של מוצר <strong>פגום או שגוי<\/strong> נדאג לכם למוצר חלופי על חשבוננו. לפרטים המלאים ומדיניות ההחזרה מוזמנים לעיין ב<a href=\"https:\/\/hashofet.com\/pages\/תקנון\">תקנון<\/a> או לפנות לשירות הלקוחות.\n      <\/div>\n    <\/details>\n  <\/div>\n\n  <div class=\"super-faq-item\">\n    <details>\n      <summary>\n        <div class=\"faq-q-content\">\n          <div class=\"faq-icon\">\n            <svg viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\"><circle cx=\"11\" cy=\"11\" r=\"8\"><\/circle><line x1=\"21\" y1=\"21\" x2=\"16.65\" y2=\"16.65\"><\/line><\/svg>\n          <\/div>\n          <span>איפה ניתן למצוא מוצרים שאין בחנות?<\/span>\n        <\/div>\n        <div class=\"faq-toggle-icon\"><svg viewBox=\"0 0 24 24\" fill=\"none\" stroke-width=\"3\" stroke-linecap=\"round\" stroke-linejoin=\"round\"><polyline points=\"6 9 12 15 18 9\"><\/polyline><\/svg><\/div>\n      <\/summary>\n      <div class=\"super-faq-answer\">\n        במקרה שלא מצאתם מוצר מסוים באתר, <strong>ניתן לפנות לשירות הלקוחות שלנו.<\/strong> אנו נבדוק זמינות מול הספקים ונעדכן אתכם בהקדם האפשרי.\n      <\/div>\n    <\/details>\n  <\/div>\n\n  <div class=\"super-faq-item\">\n    <details>\n      <summary>\n        <div class=\"faq-q-content\">\n          <div class=\"faq-icon\">\n            <svg viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\"><path d=\"M1 12s4-8 11-8 11 8 11 8-4 8-11 8-11-8-11-8z\"><\/path><circle cx=\"12\" cy=\"12\" r=\"3\"><\/circle><\/svg>\n          <\/div>\n          <span>מה ההבדל בין גרסת שחקן לגרסת אוהד?<\/span>\n        <\/div>\n        <div class=\"faq-toggle-icon\"><svg viewBox=\"0 0 24 24\" fill=\"none\" stroke-width=\"3\" stroke-linecap=\"round\" stroke-linejoin=\"round\"><polyline points=\"6 9 12 15 18 9\"><\/polyline><\/svg><\/div>\n      <\/summary>\n      <div class=\"super-faq-answer\">\n        <strong>גרסת שחקן<\/strong> - מותאמת לשימוש מקצועי במשחקי כדורגל. הבד אלסטי, צמוד לגוף, קל משקל ומיועד לביצועים גבוהים - בדיוק כמו זה של השחקנים במשחקים רשמיים.\n        <br><br>\n        <strong>גרסת אוהד<\/strong> - מותאמת ללבישה יומיומית ולאירועי ספורט. הבד מעט רפוי יותר, נוח ואוורירי, ומתאים למי שמעוניין במראה ונוחות מבלי לוותר על עיצוב מקורי.\n        <br><br>\n        <strong>שימו לב:<\/strong> מכנסיים הנמכרים כחלק מסט מיוצרים בגרסת אוהד בלבד, גם אם החולצה בסט היא בגרסת שחקן.\n      <\/div>\n    <\/details>\n  <\/div>\n\n  <div class=\"super-faq-item\">\n    <details>\n      <summary>\n        <div class=\"faq-q-content\">\n          <div class=\"faq-icon\">\n            <svg viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\"><path d=\"M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0 1 18 0z\"><\/path><circle cx=\"12\" cy=\"10\" r=\"3\"><\/circle><\/svg>\n          <\/div>\n          <span>יש חנות פיזית?<\/span>\n        <\/div>\n        <div class=\"faq-toggle-icon\"><svg viewBox=\"0 0 24 24\" fill=\"none\" stroke-width=\"3\" stroke-linecap=\"round\" stroke-linejoin=\"round\"><polyline points=\"6 9 12 15 18 9\"><\/polyline><\/svg><\/div>\n      <\/summary>\n      <div class=\"super-faq-answer\">\n        לצערנו לא, אנחנו עושים רק משלוחים - המשלוח הוא חינם, אמין ומהיר.\n      <\/div>\n    <\/details>\n  <\/div>\n\n  <div class=\"super-faq-footer\">\n    לא מצאתם תשובה? <a href=\"https:\/\/wa.me\/972515310498\" target=\"_blank\">דברו איתנו בוואטסאפ 💬<\/a>\n  <\/div>\n\n<\/div>","color_scheme":"","padding_top":40,"padding_bottom":52}}},"order":["main","custom_liquid_EmDJ6E"]}