{"sections":{"main":{"type":"main-page","disabled":true,"custom_css":["h2 {text-align: center;}"],"settings":{"padding_top":28,"padding_bottom":28}},"custom_liquid_VCCfmP":{"type":"custom-liquid","name":"t:sections.custom-liquid.presets.name","settings":{"custom_liquid":"<style>\n  .pay-guide {\n    direction: rtl;\n    max-width: 760px;\n    margin: 0 auto;\n    padding: 10px 20px 70px;\n    font-family: 'Assistant', system-ui, -apple-system, sans-serif;\n  }\n\n  \/* ---- intro ---- *\/\n  .pay-guide__head { text-align: center; margin-bottom: 14px; }\n  .pay-guide__badge {\n    display: inline-flex; align-items: center; gap: 7px;\n    background: rgba(37,211,102,.10);\n    border: 1px solid rgba(37,211,102,.4);\n    color: #128C4B; font-size: 13px; font-weight: 700;\n    padding: 7px 16px; border-radius: 100px; margin-bottom: 16px;\n  }\n  .pay-guide__title {\n    font-size: 30px; font-weight: 900; color: #121212;\n    margin: 0 0 10px; letter-spacing: -0.4px;\n  }\n  .pay-guide__sub {\n    font-size: 15px; color: #6b7280; margin: 0 auto 24px; max-width: 520px; line-height: 1.7;\n  }\n\n  \/* ---- steps ---- *\/\n  .pay-guide__step {\n    position: relative;\n    background:\n      linear-gradient(180deg, rgba(255,255,255,0.9) 0%, rgba(255,255,255,0) 18%),\n      linear-gradient(180deg, #ffffff 0%, #f8f6f1 100%);\n    border: 1px solid #e7e4dc;\n    border-radius: 20px;\n    box-shadow:\n      inset 0 1px 0 rgba(255,255,255,0.9),\n      0 1px 2px rgba(15,27,42,0.04),\n      0 8px 20px rgba(15,27,42,0.06);\n    padding: 28px 26px 26px;\n    margin-bottom: 46px;\n  }\n\n  \/* connector line between steps *\/\n  .pay-guide__step:not(:last-of-type)::after {\n    content: \"\";\n    position: absolute;\n    bottom: -46px;\n    right: 47px;\n    width: 3px;\n    height: 46px;\n    background: repeating-linear-gradient(\n      180deg,\n      rgba(37,211,102,.5) 0 6px,\n      transparent 6px 12px\n    );\n  }\n\n  .pay-guide__step-head {\n    display: flex; align-items: center; gap: 14px; margin-bottom: 12px;\n  }\n  .pay-guide__num {\n    display: flex; align-items: center; justify-content: center;\n    width: 46px; height: 46px; flex-shrink: 0;\n    border-radius: 50%;\n    background: #25D366;\n    color: #ffffff;\n    font-size: 20px; font-weight: 900;\n    box-shadow: 0 4px 12px rgba(37,211,102,.35);\n  }\n  .pay-guide__step-title {\n    font-size: 20px; font-weight: 800; color: #121212; margin: 0;\n  }\n  .pay-guide__text {\n    font-size: 15px; line-height: 1.8; color: #4b5563; margin: 0 0 18px;\n  }\n  .pay-guide__text strong { color: #121212; }\n\n  .pay-guide__img {\n    width: 100%; height: auto; display: block;\n    border-radius: 14px;\n    border: 1px solid #eae8e1;\n    box-shadow: 0 6px 18px rgba(15,27,42,0.08);\n  }\n\n  \/* ---- info \/ secure boxes ---- *\/\n  .pay-guide__secure {\n    display: flex; align-items: flex-start; gap: 12px;\n    background: rgba(37,211,102,.07);\n    border: 1px solid rgba(37,211,102,.35);\n    border-radius: 16px;\n    padding: 18px 20px;\n    margin: 8px 0 34px;\n    text-align: right;\n  }\n  .pay-guide__secure-icon { font-size: 22px; line-height: 1.3; }\n  .pay-guide__secure-text {\n    font-size: 14px; line-height: 1.7; color: #1f2937; margin: 0;\n  }\n  .pay-guide__secure-text strong { color: #128C4B; }\n\n  \/* amber \"notice\" variant *\/\n  .pay-guide__notice {\n    background: rgba(245,179,1,.08);\n    border-color: rgba(245,179,1,.45);\n  }\n  .pay-guide__notice .pay-guide__secure-text strong { color: #9a6b00; }\n\n  \/* ---- help CTA ---- *\/\n  .pay-guide__help {\n    text-align: center;\n  }\n  .pay-guide__help p {\n    font-size: 15px; color: #6b7280; margin: 0 0 14px;\n  }\n  .pay-guide__help a {\n    display: inline-flex; align-items: center; gap: 8px;\n    background: #25D366; color: #ffffff; text-decoration: none;\n    font-size: 15px; font-weight: 800;\n    padding: 13px 28px; border-radius: 100px;\n    transition: transform .2s ease, box-shadow .2s ease;\n    box-shadow: 0 6px 20px rgba(37,211,102,.3);\n  }\n  .pay-guide__help a:hover {\n    transform: translateY(-2px);\n    box-shadow: 0 10px 26px rgba(37,211,102,.4);\n  }\n\n  @media (max-width: 749px) {\n    .pay-guide { padding: 6px 14px 54px; }\n    .pay-guide__title { font-size: 24px; }\n    .pay-guide__step { padding: 22px 16px 20px; margin-bottom: 38px; }\n    .pay-guide__step:not(:last-of-type)::after { bottom: -38px; height: 38px; right: 38px; }\n    .pay-guide__num { width: 40px; height: 40px; font-size: 17px; }\n    .pay-guide__step-title { font-size: 17px; }\n    .pay-guide__text { font-size: 14px; }\n  }\n<\/style>\n\n<div class=\"pay-guide\">\n\n  <div class=\"pay-guide__head\">\n    <div class=\"pay-guide__badge\">🔒 תשלום מאובטח<\/div>\n    <h1 class=\"pay-guide__title\">מדריך לתשלום באשראי<\/h1>\n    <p class=\"pay-guide__sub\">\n      התשלום באתר מתבצע דרך מערכת הסליקה המאובטחת של PayPal —\n      אפשר לשלם בכרטיס אשראי רגיל, <strong>גם בלי חשבון PayPal<\/strong>.\n      ככה זה עובד, צעד אחר צעד:\n    <\/p>\n  <\/div>\n\n  <div class=\"pay-guide__secure\">\n    <div class=\"pay-guide__secure-icon\">💡<\/div>\n    <p class=\"pay-guide__secure-text\">\n      <strong>למה דרך PayPal?<\/strong>\n      בחרנו לעבוד עם מערכת הסליקה הגדולה בעולם כי היא נותנת לכם\n      את ההגנה החזקה ביותר שיש: הצפנה מלאה, ותוכנית\n      <strong>הגנת הקונה של PayPal<\/strong> שמכסה כל עסקה.\n      פרטי הכרטיס לא עוברים דרכנו בשום שלב.\n    <\/p>\n  <\/div>\n\n  <div class=\"pay-guide__secure pay-guide__notice\">\n    <div class=\"pay-guide__secure-icon\">💻<\/div>\n    <p class=\"pay-guide__secure-text\">\n      <strong>שימו לב:<\/strong>\n      אפשרות התשלום בכרטיס אשראי זמינה <strong>דרך מחשב בלבד<\/strong>.\n      גולשים מהנייד? שמרו את העגלה והשלימו את ההזמנה מהמחשב —\n      או שלחו לנו הודעה בוואטסאפ ונעזור.\n    <\/p>\n  <\/div>\n\n  <div class=\"pay-guide__step\">\n    <div class=\"pay-guide__step-head\">\n      <div class=\"pay-guide__num\">1<\/div>\n      <h3 class=\"pay-guide__step-title\">ממשיכים לתשלום<\/h3>\n    <\/div>\n    <p class=\"pay-guide__text\">\n      אחרי שסיימתם לבחור מוצרים והעגלה מוכנה — לוחצים על <strong>\"מעבר לתשלום\"<\/strong>\n    <\/p>\n    <img class=\"pay-guide__img\" src=\"https:\/\/cdn.shopify.com\/s\/files\/1\/0707\/4938\/9043\/files\/image_2026-07-19_095218424.png?v=1784443942\" alt=\"שלב 1 - מעבר לעמוד התשלום\" loading=\"lazy\">\n  <\/div>\n\n  <div class=\"pay-guide__step\">\n    <div class=\"pay-guide__step-head\">\n      <div class=\"pay-guide__num\">2<\/div>\n      <h3 class=\"pay-guide__step-title\">ממלאים פרטים ובוחרים PayPal<\/h3>\n    <\/div>\n    <p class=\"pay-guide__text\">\n      בוחרים <strong>בתשלום מהיר דרך PayPal<\/strong> — זו המערכת דרכה מתבצע התשלום דרך כרטיס אשראי.\n    <\/p>\n    <img class=\"pay-guide__img\" src=\"https:\/\/cdn.shopify.com\/s\/files\/1\/0707\/4938\/9043\/files\/image_2026-07-19_095322760.png?v=1784444006\" alt=\"שלב 2 - מילוי פרטים ובחירת PayPal\" loading=\"lazy\">\n  <\/div>\n\n  <div class=\"pay-guide__step\">\n    <div class=\"pay-guide__step-head\">\n      <div class=\"pay-guide__num\">3<\/div>\n      <h3 class=\"pay-guide__step-title\">בוחרים תשלום בכרטיס אשראי<\/h3>\n    <\/div>\n    <p class=\"pay-guide__text\">\n      בחלון שנפתח בוחרים באפשרות <strong>\"תשלום בכרטיס אשראי \/ חיוב\"<\/strong> —\n      האפשרות זמינה לכולם, גם למי שאין לו חשבון PayPal.\n      <strong>שימו לב: האפשרות מופיעה דרך מחשב בלבד.<\/strong>\n    <\/p>\n    <img class=\"pay-guide__img\" src=\"https:\/\/cdn.shopify.com\/s\/files\/1\/0707\/4938\/9043\/files\/image_2026-07-19_095356545.png?v=1784444041\" alt=\"שלב 3 - בחירת תשלום בכרטיס אשראי ללא חשבון PayPal\" loading=\"lazy\">\n  <\/div>\n\n  <div class=\"pay-guide__step\">\n    <div class=\"pay-guide__step-head\">\n      <div class=\"pay-guide__num\">4<\/div>\n      <h3 class=\"pay-guide__step-title\">ממלאים פרטים<\/h3>\n    <\/div>\n    <p class=\"pay-guide__text\">\n      ממלאים את הפרטים הנדרשים בטופס לפי ההנחיות על המסך.\n    <\/p>\n    <img class=\"pay-guide__img\" src=\"https:\/\/cdn.shopify.com\/s\/files\/1\/0707\/4938\/9043\/files\/image_2026-07-19_095438316.png?v=1784444081\" alt=\"שלב 4 - מילוי פרטים\" loading=\"lazy\">\n  <\/div>\n\n  <div class=\"pay-guide__step\">\n    <div class=\"pay-guide__step-head\">\n      <div class=\"pay-guide__num\">5<\/div>\n      <h3 class=\"pay-guide__step-title\">משלימים את התשלום<\/h3>\n    <\/div>\n    <p class=\"pay-guide__text\">\n      מאשרים את התשלום — <strong>בלי צורך לפתוח חשבון PayPal<\/strong>.\n      זהו! תקבלו <strong>אישור הזמנה למייל<\/strong> מיד לאחר התשלום.\n    <\/p>\n    <img class=\"pay-guide__img\" src=\"https:\/\/cdn.shopify.com\/s\/files\/1\/0707\/4938\/9043\/files\/image_2026-07-19_095524223.png?v=1784444127\" alt=\"שלב 5 - השלמת התשלום ללא חשבון PayPal\" loading=\"lazy\">\n  <\/div>\n\n  <div class=\"pay-guide__secure\">\n    <div class=\"pay-guide__secure-icon\">🔒<\/div>\n    <p class=\"pay-guide__secure-text\">\n      <strong>למה זה בטוח?<\/strong>\n      פרטי האשראי שלכם מוזנים ישירות במערכת המוצפנת של PayPal —\n      אחת ממערכות הסליקה הגדולות והמאובטחות בעולם.\n      פרטי הכרטיס לא נשמרים אצלנו ולא עוברים דרכנו בשום שלב.\n    <\/p>\n  <\/div>\n\n  <div class=\"pay-guide__help\">\n    <p>נתקעתם באחד השלבים? אנחנו כאן.<\/p>\n    <a href=\"https:\/\/api.whatsapp.com\/send?phone=972515310498&text=שלום!%20אשמח%20לעזרה%20בחנות%20השופט\">דברו איתנו בוואטסאפ 💬<\/a>\n  <\/div>\n\n<\/div>","color_scheme":"","padding_top":40,"padding_bottom":52}}},"order":["main","custom_liquid_VCCfmP"]}