{"sections":{"main":{"type":"main-page","disabled":true,"custom_css":["h2 {text-align: center;}"],"settings":{"padding_top":28,"padding_bottom":28}},"custom_liquid_EmDJ6E":{"type":"custom-liquid","name":"t:sections.custom-liquid.presets.name","settings":{"custom_liquid":"<style>\n  \/* --- GLOBAL SECTION RESET --- *\/\n  .shopify-section-custom-liquid {\n    display: block !important;\n    padding: 0 !important;\n    margin: 0 !important;\n  }\n\n  \/* --- MAIN WRAPPER --- *\/\n  .super-faq-wrapper {\n    width: 100%;\n    max-width: 1000px;\n    margin: 80px auto;\n    padding: 0 20px;\n    font-family: 'Assistant', system-ui, -apple-system, sans-serif;\n    direction: rtl; \/* For Hebrew *\/\n  }\n\n  \/* --- TITLE (MASSIVE & MUNDIAL THEMED) --- *\/\n  .super-faq-title {\n    text-align: center;\n    font-size: 3.5rem;\n    font-weight: 900;\n    background: linear-gradient(45deg, #111111, #D4AF37, #111111);\n    -webkit-background-clip: text;\n    -webkit-text-fill-color: transparent;\n    margin-bottom: 20px; \/* Reduced to fit intro *\/\n    letter-spacing: -0.02em;\n  }\n\n  \/* --- INTRO PARAGRAPH (NEW) --- *\/\n  .super-faq-intro {\n    background-color: rgba(212, 175, 55, 0.08);\n    border: 1px solid rgba(212, 175, 55, 0.3);\n    border-radius: 12px;\n    padding: 25px 30px;\n    text-align: center;\n    margin-bottom: 50px;\n    font-size: 1.25rem;\n    line-height: 1.6;\n    color: #333;\n    box-shadow: 0 4px 15px rgba(0, 0, 0, 0.02);\n  }\n\n  .super-faq-intro strong {\n    color: #111;\n    font-weight: 800;\n  }\n\n  \/* --- FAQ ITEMS (THE CARDS) --- *\/\n  .super-faq-item {\n    background: linear-gradient(to left, #ffffff, #fafafa);\n    border-radius: 16px;\n    margin-bottom: 25px;\n    box-shadow: 0 8px 25px rgba(0, 0, 0, 0.04);\n    border: 1px solid rgba(212, 175, 55, 0.15);\n    border-right: 6px solid #D4AF37; \/* Premium Ticket Vibe *\/\n    overflow: hidden;\n    transition: all 0.3s ease;\n  }\n\n  .super-faq-item:hover {\n    box-shadow: 0 12px 35px rgba(212, 175, 55, 0.15);\n    transform: translateY(-4px);\n    border-color: #D4AF37;\n  }\n\n  \/* --- NATIVE ACCORDION LOGIC --- *\/\n  details {\n    width: 100%;\n  }\n\n  summary {\n    list-style: none;\n    padding: 30px;\n    font-size: 1.6rem;\n    font-weight: 800;\n    color: #111;\n    cursor: pointer;\n    display: flex;\n    align-items: center;\n    justify-content: space-between;\n    transition: background 0.3s ease;\n  }\n\n  summary::-webkit-details-marker {\n    display: none; \n  }\n\n  summary:focus {\n    outline: none;\n  }\n\n  \/* Highlight slightly on hover to show it's clickable *\/\n  summary:hover {\n    background: rgba(212, 175, 55, 0.03);\n  }\n\n  .faq-q-content {\n    display: flex;\n    align-items: center;\n    gap: 20px;\n  }\n\n  \/* --- ICONS (GOLD MEDAL STYLE) --- *\/\n  .faq-icon {\n    display: flex;\n    align-items: center;\n    justify-content: center;\n    width: 54px;\n    height: 54px;\n    background: linear-gradient(135deg, #D4AF37, #AA8222);\n    color: #fff;\n    border-radius: 50%;\n    box-shadow: 0 4px 15px rgba(212, 175, 55, 0.4);\n    flex-shrink: 0;\n  }\n\n  .faq-icon svg {\n    width: 28px;\n    height: 28px;\n  }\n\n  \/* --- CLICK TO OPEN BUTTON AREA --- *\/\n  .faq-action-area {\n    display: flex;\n    align-items: center;\n    gap: 12px;\n    background: rgba(212, 175, 55, 0.1);\n    padding: 8px 18px;\n    border-radius: 30px;\n    transition: all 0.3s ease;\n    animation: gentlePulse 2.5s infinite;\n  }\n\n  .super-faq-item:hover .faq-action-area {\n    background: #D4AF37;\n    animation: none;\n    transform: scale(1.05);\n  }\n\n  .click-to-open-text {\n    font-size: 1.1rem;\n    font-weight: 700;\n    color: #AA8222;\n    transition: color 0.3s ease;\n  }\n\n  .super-faq-item:hover .click-to-open-text {\n    color: #fff;\n  }\n\n  \/* Pure CSS Plus\/Minus inside the button *\/\n  .faq-toggle-icon {\n    position: relative;\n    width: 20px;\n    height: 20px;\n    flex-shrink: 0;\n  }\n\n  .faq-toggle-icon::before,\n  .faq-toggle-icon::after {\n    content: '';\n    position: absolute;\n    background-color: #AA8222;\n    transition: all 0.3s ease;\n    border-radius: 2px;\n  }\n\n  .super-faq-item:hover .faq-toggle-icon::before,\n  .super-faq-item:hover .faq-toggle-icon::after {\n    background-color: #fff;\n  }\n\n  .faq-toggle-icon::before {\n    top: 9px; left: 0; width: 20px; height: 2.5px;\n  }\n  .faq-toggle-icon::after {\n    top: 0; left: 8.75px; width: 2.5px; height: 20px;\n  }\n\n  \/* WHEN OPENED *\/\n  details[open] .faq-toggle-icon::after {\n    transform: rotate(90deg);\n    opacity: 0;\n  }\n  \n  details[open] .click-to-open-text {\n    display: none; \/* Hides the text when open *\/\n  }\n\n  details[open] .faq-action-area {\n    background: transparent;\n    animation: none;\n    padding: 8px;\n  }\n  \n  details[open] .faq-toggle-icon::before {\n    background-color: #111; \/* Turn minus black when open *\/\n  }\n\n  @keyframes gentlePulse {\n    0% { box-shadow: 0 0 0 0 rgba(212, 175, 55, 0.4); }\n    70% { box-shadow: 0 0 0 10px rgba(212, 175, 55, 0); }\n    100% { box-shadow: 0 0 0 0 rgba(212, 175, 55, 0); }\n  }\n\n  \/* --- THE ANSWER CONTENT --- *\/\n  .super-faq-answer {\n    padding: 0 40px 35px 90px;\n    font-size: 1.35rem;\n    line-height: 1.7;\n    color: #444;\n    font-weight: 500;\n  }\n\n  .super-faq-answer strong {\n    color: #111;\n    font-weight: 800;\n    background: rgba(212, 175, 55, 0.15);\n    padding: 0 4px;\n    border-radius: 4px;\n  }\n\n  .super-faq-answer a {\n    color: #D4AF37;\n    text-decoration: underline;\n    font-weight: bold;\n    transition: color 0.3s ease;\n  }\n  \n  .super-faq-answer a:hover {\n    color: #111;\n  }\n\n  details[open] summary ~ * {\n    animation: sweep 0.4s ease-in-out;\n  }\n\n  @keyframes sweep {\n    0%    { opacity: 0; transform: translateY(-10px); }\n    100%  { opacity: 1; transform: translateY(0); }\n  }\n\n  \/* --- MOBILE RESPONSIVENESS --- *\/\n  @media screen and (max-width: 749px) {\n    .super-faq-wrapper {\n      margin: 50px auto;\n    }\n\n    .super-faq-title {\n      font-size: 2.6rem;\n      margin-bottom: 20px;\n    }\n\n    .super-faq-intro {\n      font-size: 1.1rem;\n      padding: 20px;\n      margin-bottom: 40px;\n    }\n\n    summary {\n      padding: 20px;\n      font-size: 1.3rem;\n    }\n\n    .faq-q-content {\n      gap: 15px;\n    }\n\n    .faq-icon {\n      width: 44px;\n      height: 44px;\n    }\n\n    .faq-icon svg {\n      width: 22px;\n      height: 22px;\n    }\n\n    .click-to-open-text {\n      display: none; \/* Hide text on mobile to save space, keep only the pulsing plus *\/\n    }\n\n    .faq-action-area {\n      padding: 10px;\n      border-radius: 50%;\n    }\n\n    .super-faq-answer {\n      padding: 0 20px 25px 20px;\n      font-size: 1.2rem;\n    }\n  }\n<\/style>\n\n<div class=\"super-faq-wrapper\">\n  <h2 class=\"super-faq-title\">מידע על המונדיאל<\/h2>\n\n  <!-- INTRO PARAGRAPH -->\n  <div class=\"super-faq-intro\">\n    אוהדים יקרים 🏆, בגלל טירוף המונדיאל יש עומס פניות חריג בשירות הלקוחות שלנו.<br>\n    ריכזנו כאן את <strong>כל התשובות לשאלות שלכם<\/strong> (כן, גם מתי ההזמנה תגיע). קריאה של הדקה הקרובה תחסוך לכם זמן המתנה יקר לנציג. אנחנו מבטיחים שההזמנות של כולם מטופלות ונשלחות הכי מהר שאפשר, בהתייחס למצב.\n  <\/div>\n\n  <!-- Q1: Pickup -->\n  <div class=\"super-faq-item\">\n    <details>\n      <summary>\n        <div class=\"faq-q-content\">\n          <div class=\"faq-icon\">\n            <svg viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\"><path d=\"M21 16V8a2 2 0 0 0-1-1.73l-7-4a2 2 0 0 0-2 0l-7 4A2 2 0 0 0 3 8v8a2 2 0 0 0 1 1.73l7 4a2 2 0 0 0 2 0l7-4A2 2 0 0 0 21 16z\"><\/path><polyline points=\"3.27 6.96 12 12.01 20.73 6.96\"><\/polyline><line x1=\"12\" y1=\"22.08\" x2=\"12\" y2=\"12\"><\/line><\/svg>\n          <\/div>\n          <span>האם אפשר לבוא ולאסוף?<\/span>\n        <\/div>\n        <div class=\"faq-action-area\">\n          <span class=\"click-to-open-text\">לחצו לתשובה<\/span>\n          <div class=\"faq-toggle-icon\"><\/div>\n        <\/div>\n      <\/summary>\n      <div class=\"super-faq-answer\">\n        לצערנו לא, המשלוחים יבוצעו רק <strong>לנקודת איסוף סמוכה<\/strong> לכתובת ההזמנה.\n      <\/div>\n    <\/details>\n  <\/div>\n\n  <!-- Q2: Expedite -->\n  <div class=\"super-faq-item\">\n    <details>\n      <summary>\n        <div class=\"faq-q-content\">\n          <div class=\"faq-icon\">\n            <svg viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\"><polygon points=\"13 2 3 14 12 14 11 22 21 10 12 10 13 2\"><\/polygon><\/svg>\n          <\/div>\n          <span>אפשר לזרז את ההזמנה שלי?<\/span>\n        <\/div>\n        <div class=\"faq-action-area\">\n          <span class=\"click-to-open-text\">לחצו לתשובה<\/span>\n          <div class=\"faq-toggle-icon\"><\/div>\n        <\/div>\n      <\/summary>\n      <div class=\"super-faq-answer\">\n        אנחנו מעבדים את ההזמנות של כל לקוח הכי מהר שאפשר. לצערנו, השאר לא תלוי בנו אלא <strong>בעומס על המפעל<\/strong>, תדירות הטיסות, בדיקות המכס, ומיון במרכז ההפצה.\n      <\/div>\n    <\/details>\n  <\/div>\n\n  <!-- Q3: Delivery Time -->\n  <div class=\"super-faq-item\">\n    <details>\n      <summary>\n        <div class=\"faq-q-content\">\n          <div class=\"faq-icon\">\n            <svg viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\"><rect x=\"3\" y=\"4\" width=\"18\" height=\"18\" rx=\"2\" ry=\"2\"><\/rect><line x1=\"16\" y1=\"2\" x2=\"16\" y2=\"6\"><\/line><line x1=\"8\" y1=\"2\" x2=\"8\" y2=\"6\"><\/line><line x1=\"3\" y1=\"10\" x2=\"21\" y2=\"10\"><\/line><\/svg>\n          <\/div>\n          <span>מתי ההזמנה שלי תגיע?<\/span>\n        <\/div>\n        <div class=\"faq-action-area\">\n          <span class=\"click-to-open-text\">לחצו לתשובה<\/span>\n          <div class=\"faq-toggle-icon\"><\/div>\n        <\/div>\n      <\/summary>\n<div class=\"super-faq-answer\">\n        אורך המשלוח שלנו שקוף בעמוד השאלות הנפוצות ובתקנון.<br>\n        בתקופת המונדיאל, בשל העומסים החריגים, ההזמנות מגיעות קרוב יותר לטווח העליון של ההערכה שלנו - <strong>עד 21 ימי עסקים<\/strong> ממועד התשלום על ההזמנה.<br><br>\n        <span style=\"display: block; background: rgba(212, 175, 55, 0.1); padding: 15px; border-radius: 8px; border-right: 4px solid #D4AF37; margin-top: 10px;\">\n          <strong>💡 חשוב לדעת כשאתם בודקים מעקב:<\/strong><br>\n          אל תיבהלו אם הסטטוס מראה שהחבילה \"יצאה מחו\"ל\" רק אחרי 10 או 14 ימים! תהליך הייצור, ההדפסה והאריזה במפעל הוא החלק הארוך ביותר. מרגע שהחבילה פיזית עולה על הטיסה (יוצאת מהונג קונג\/סין), היא מגיעה לישראל ומופצת אליכם די מהר. פשוט תספרו 21 ימי עסקים מיום ההזמנה.\n        <\/span>\n      <\/div>\n    <\/details>\n  <\/div>\n\n  <!-- Q4: ETA -->\n  <div class=\"super-faq-item\">\n    <details>\n      <summary>\n        <div class=\"faq-q-content\">\n          <div class=\"faq-icon\">\n            <svg viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\"><circle cx=\"12\" cy=\"12\" r=\"10\"><\/circle><polyline points=\"12 6 12 12 16 14\"><\/polyline><\/svg>\n          <\/div>\n          <span>מה הצפי למשלוח שלי?<\/span>\n        <\/div>\n        <div class=\"faq-action-area\">\n          <span class=\"click-to-open-text\">לחצו לתשובה<\/span>\n          <div class=\"faq-toggle-icon\"><\/div>\n        <\/div>\n      <\/summary>\n      <div class=\"super-faq-answer\">\n        ניתן לספור כמה ימי עסקים עברו מאז השלמת התשלום <strong>ולהחסיר מ-21<\/strong>. זוהי ההערכה הכי מדויקת שאפשר לקבל בתקופה זו - עבור כל המשלוחים ללא יוצא מן הכלל.\n      <\/div>\n    <\/details>\n  <\/div>\n\n  <!-- Q5: Tracking -->\n  <div class=\"super-faq-item\">\n    <details>\n      <summary>\n        <div class=\"faq-q-content\">\n          <div class=\"faq-icon\">\n            <svg viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\"><circle cx=\"11\" cy=\"11\" r=\"8\"><\/circle><line x1=\"21\" y1=\"21\" x2=\"16.65\" y2=\"16.65\"><\/line><\/svg>\n          <\/div>\n          <span>איך אני עוקב אחרי המשלוח שלי?<\/span>\n        <\/div>\n        <div class=\"faq-action-area\">\n          <span class=\"click-to-open-text\">לחצו לתשובה<\/span>\n          <div class=\"faq-toggle-icon\"><\/div>\n        <\/div>\n      <\/summary>\n      <div class=\"super-faq-answer\">\n        אפשר לעקוב אחרי המשלוח בקישור הבא: <a href=\"https:\/\/hashofet.com\/apps\/17TRACK\" target=\"_blank\">לחצו כאן למעקב<\/a>.<br><br>\n        הזינו את <strong>מספר הטלפון שלכם + מספר ההזמנה<\/strong> (שקיבלתם במייל כשסיימתם את ההזמנה).<br><br>\n        <em>שימו לב:<\/em> אם עדיין אין מידע בדף המעקב, זה אומר שההזמנה שלכם עדיין <strong>בהכנות ואריזה<\/strong> (התהליך שלוקח הכי הרבה זמן בתקופה העמוסה הזו). ברגע שתצא, המידע יתעדכן.\n      <\/div>\n    <\/details>\n  <\/div>\n\n  <!-- Q6: Specific Date -->\n  <div class=\"super-faq-item\">\n    <details>\n      <summary>\n        <div class=\"faq-q-content\">\n          <div class=\"faq-icon\">\n            <svg viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\"><path d=\"M10.29 3.86L1.82 18a2 2 0 0 0 1.71 3h16.94a2 2 0 0 0 1.71-3L13.71 3.86a2 2 0 0 0-3.42 0z\"><\/path><line x1=\"12\" y1=\"9\" x2=\"12\" y2=\"13\"><\/line><line x1=\"12\" y1=\"17\" x2=\"12.01\" y2=\"17\"><\/line><\/svg>\n          <\/div>\n          <span>אני צריך את ההזמנה לתאריך מסוים<\/span>\n        <\/div>\n        <div class=\"faq-action-area\">\n          <span class=\"click-to-open-text\">לחצו לתשובה<\/span>\n          <div class=\"faq-toggle-icon\"><\/div>\n        <\/div>\n      <\/summary>\n      <div class=\"super-faq-answer\">\n        לצערנו אנחנו לא יכולים להבטיח תאריך\/דדליין להזמנה בשל התקופה החריגה של המונדיאל. אם ההזמנה חשובה לכם לתאריך מסוים <strong>אנחנו ממליצים לא להזמין<\/strong>.\n      <\/div>\n    <\/details>\n  <\/div>\n\n<\/div>","color_scheme":"","padding_top":40,"padding_bottom":52}}},"order":["main","custom_liquid_EmDJ6E"]}