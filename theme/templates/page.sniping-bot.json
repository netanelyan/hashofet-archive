}}},"block_order":["heading_JqiNP7","text_J79q9f"],"settings":{"image":"shopify:\/\/shop_images\/image_2024-10-13_181248118.png","height":"adapt","desktop_image_width":"medium","layout":"image_first","desktop_content_position":"top","desktop_content_alignment":"left","content_layout":"no-overlap","section_color_scheme":"","color_scheme":"","image_behavior":"none","mobile_content_alignment":"left","padding_top":36,"padding_bottom":36}},"rich_text_xU6LYp":{"type":"rich-text","blocks":{"heading_htctR9":{"type":"heading","settings":{"heading":"פילטר","heading_size":"h1"}}},"block_order":["heading_htctR9"],"settings":{"desktop_content_position":"center","content_alignment":"center","color_scheme":"","full_width":true,"padding_top":40,"padding_bottom":52}},"image_with_text_PqaUAW":{"type":"image-with-text","blocks":{"text_HgYBJz":{"type":"text","settings":{"text":"<p>בצד שמאל יש לשים את הפילטר שתרצו לצלוף, לדוגמא: אם תרצו לצלוף שחקנים גרמניים מהפרמייר ליג זה מה שתבחרו ותגדירו. פילטר יכול להיות גם שחקן ספציפי.<\/p>","text_style":"body"}}},"block_order":["text_HgYBJz"],"settings":{"image":"shopify:\/\/shop_images\/image_2024-10-13_181537722.png","height":"adapt","desktop_image_width":"medium","layout":"image_first","desktop_content_position":"top","desktop_content_alignment":"left","content_layout":"no-overlap","section_color_scheme":"","color_scheme":"","image_behavior":"none","mobile_content_alignment":"left","padding_top":36,"padding_bottom":36}},"image_with_text_3x9a3M":{"type":"image-with-text","blocks":{"text_rpkVUh":{"type":"text","settings":{"text":"<p>כאן יש להקליד את המחיר המקסימלי שתרצו לרכוש את הפילטר שלכם.<\/p>","text_style":"body"}}},"block_order":["text_rpkVUh"],"settings":{"image":"shopify:\/\/shop_images\/image_2024-10-13_181623447.png","height":"adapt","desktop_image_width":"medium","layout":"image_first","desktop_content_position":"top","desktop_content_alignment":"left","content_layout":"no-overlap","section_color_scheme":"","color_scheme":"","image_behavior":"none","mobile_content_alignment":"left","padding_top":36,"padding_bottom":36}},"rich_text_yy7Je8":{"type":"rich-text","blocks":{"heading_Q6DqNP":{"type":"heading","settings":{"heading":"הפעלת הבוט","heading_size":"h1"}}},"block_order":["heading_Q6DqNP"],"settings":{"desktop_content_position":"center","content_alignment":"center","color_scheme":"","full_width":true,"padding_top":40,"padding_bottom":52}},"image_with_text_cbHBrE":{"type":"image-with-text","blocks":{"text_HTwhXj":{"type":"text","settings":{"text":"<p>לא חובה - אם אתם מעוניינים שהבוט ימכור את התפיסות אוטומטית יש לסמן בוי את הקופסא בימין ולבחור מחירים בשמאל - למעלה לשים את מחיר הביד ולמטה לשים את מחיר הקנייה. אנחנו לא ממליצים<\/p>","text_style":"body"}}},"block_order":["text_HTwhXj"],"settings":{"image":"shopify:\/\/shop_images\/image_2024-10-13_181755281.png","height":"adapt","desktop_image_width":"medium","layout":"image_first","desktop_content_position":"top","desktop_content_alignment":"left","content_layout":"no-overlap","section_color_scheme":"","color_scheme":"","image_behavior":"none","mobile_content_alignment":"left","padding_top":36,"padding_bottom":36}},"image_with_text_pMHBN7":{"type":"image-with-text","blocks":{"text_9dhPbB":{"type":"text","settings":{"text":"<p>החלק החשוב ביותר - לבחור את הRPM הנכון בשבילכם. RPM זה כמות החיפושים שהבוט יבצע בדקה. הסבר מפורט יופיע בדף זה למטה. בימין ניתן להנחות לבוט לעצור אחרי פרק זמן מסויים, לא חובה<\/p>","text_style":"body"}}},"block_order":["text_9dhPbB"],"settings":{"image":"shopify:\/\/shop_images\/image_2024-10-13_181901330.png","height":"adapt","desktop_image_width":"medium","layout":"image_first","desktop_content_position":"top","desktop_content_alignment":"left","content_layout":"no-overlap","section_color_scheme":"","color_scheme":"","image_behavior":"none","mobile_content_alignment":"left","padding_top":36,"padding_bottom":36}},"image_with_text_7fbJYU":{"type":"image-with-text","blocks":{"text_X73Y93":{"type":"text","settings":{"text":"<p>דוגמא לסנייפים - חיפשתי את סאליבה שעולה 235 אלף ב210 אלף - ניתן לראות שהבוט מעדכן על החיפושים שלו, ואם ימצא שחקן כזה במרקט ירכוש אותו  ובכך עשיתי כסף בקלות.<\/p>","text_style":"body"}}},"block_order":["text_X73Y93"],"settings":{"image":"shopify:\/\/shop_images\/image_2024-10-13_182218546.png","height":"adapt","desktop_image_width":"medium","layout":"image_first","desktop_content_position":"top","desktop_content_alignment":"left","content_layout":"no-overlap","section_color_scheme":"","color_scheme":"","image_behavior":"none","mobile_content_alignment":"left","padding_top":36,"padding_bottom":36}},"rich_text_zrfG7Q":{"type":"rich-text","blocks":{"heading_7DBdYY":{"type":"heading","settings":{"heading":"RPM","heading_size":"h1"}},"text_3AfLiR":{"type":"text","settings":{"text":"<p><strong>5-7 RPM<\/strong> - הכי בטוח אך הכי איטי. אפשר להשתמש 5 שעות בלי בעיה<\/p><p><br\/><strong>10-15 RPM<\/strong> - אפשר להשתמש בו 20 דקות, להחליף ל5 RPM ל10 דקות ואז לחזור לRPM 10 ולהשמיך כך<br\/><\/p><p><strong>20-30 RPM<\/strong> - לא מומלץ מאוד, רק למי שמכיר את הבוט כבר טוב. מקסימום 5 דקות<br\/><strong><br\/>40 RPM<\/strong> - לא מומלץ בכלל, מקסימום דקה<br\/><br\/>שימו לב, אם תצמדו לכללים האלה הסיכוי שלכם לבאן הוא אפסי. אם לא הסיכוי לבאן עולה.<\/p><p><strong>חנות השופט אינה אחראית על באנים.<\/strong><\/p>"}}},"block_order":["heading_7DBdYY","text_3AfLiR"],"settings":{"desktop_content_position":"center","content_alignment":"center","color_scheme":"","full_width":true,"padding_top":40,"padding_bottom":52}}},"order":["main","rich_text_wDxAqD","rich_text_fETDad","image_with_text_8mFdXq","image_with_text_XjJwKV","image_with_text_q9tRGb","image_with_text_hJDeKc","image_with_text_itnVLa","rich_text_xU6LYp","image_with_text_PqaUAW","image_with_text_3x9a3M","rich_text_yy7Je8","image_with_text_cbHBrE","image_with_text_pMHBN7","image_with_text_7fbJYU","rich_text_zrfG7Q"]}